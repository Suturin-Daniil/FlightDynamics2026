   "outputs": [],
   "source": [
    "import sympy as sm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "1ece22fc",
   "metadata": {},
   "outputs": [],
   "source": [
    "l0, l1, l2, l3, x, y, z = sm.symbols('lambda0 lambda1 lambda2 lambda3 x y z')\n",
    "L = sm.Quaternion(l0, l1, l2, l3)\n",
    "r = sm.Quaternion(0, x, y, z)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "db99585c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle 0 + \\left(\\lambda_{0} \\left(\\lambda_{0} x - \\lambda_{2} z + \\lambda_{3} y\\right) + \\lambda_{1} \\left(\\lambda_{1} x + \\lambda_{2} y + \\lambda_{3} z\\right) - \\lambda_{2} \\left(\\lambda_{0} z - \\lambda_{1} y + \\lambda_{2} x\\right) + \\lambda_{3} \\left(\\lambda_{0} y + \\lambda_{1} z - \\lambda_{3} x\\right)\\right) i + \\left(\\lambda_{0} \\left(\\lambda_{0} y + \\lambda_{1} z - \\lambda_{3} x\\right) + \\lambda_{1} \\left(\\lambda_{0} z - \\lambda_{1} y + \\lambda_{2} x\\right) + \\lambda_{2} \\left(\\lambda_{1} x + \\lambda_{2} y + \\lambda_{3} z\\right) - \\lambda_{3} \\left(\\lambda_{0} x - \\lambda_{2} z + \\lambda_{3} y\\right)\\right) j + \\left(\\lambda_{0} \\left(\\lambda_{0} z - \\lambda_{1} y + \\lambda_{2} x\\right) - \\lambda_{1} \\left(\\lambda_{0} y + \\lambda_{1} z - \\lambda_{3} x\\right) + \\lambda_{2} \\left(\\lambda_{0} x - \\lambda_{2} z + \\lambda_{3} y\\right) + \\lambda_{3} \\left(\\lambda_{1} x + \\lambda_{2} y + \\lambda_{3} z\\right)\\right) k$"
      ],
      "text/plain": [
       "0 + (lambda0*(lambda0*x - lambda2*z + lambda3*y) + lambda1*(lambda1*x + lambda2*y + lambda3*z) - lambda2*(lambda0*z - lambda1*y + lambda2*x) + lambda3*(lambda0*y + lambda1*z - lambda3*x))*i + (lambda0*(lambda0*y + lambda1*z - lambda3*x) + lambda1*(lambda0*z - lambda1*y + lambda2*x) + lambda2*(lambda1*x + lambda2*y + lambda3*z) - lambda3*(lambda0*x - lambda2*z + lambda3*y))*j + (lambda0*(lambda0*z - lambda1*y + lambda2*x) - lambda1*(lambda0*y + lambda1*z - lambda3*x) + lambda2*(lambda0*x - lambda2*z + lambda3*y) + lambda3*(lambda1*x + lambda2*y + lambda3*z))*k"
      ]
     },
     "execution_count": 31,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "r1 = L.conjugate()*r*L\n",
    "r1.simplify()"
   ]
  },
